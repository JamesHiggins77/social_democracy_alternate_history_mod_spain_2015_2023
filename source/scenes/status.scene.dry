title: Status
new-page: true
is-special: true
on-display: {!
if (typeof window !== 'undefined' && window.SpainGame && Q.congress) {
    window.SpainGame.renderCongress(Q, 'sp-side-congress', true);
}
!}

= Status

[? if weekly = 1 : Week [+ week +], ?][+ month : month +] [+ year +]

PM: [+ pm +][? if acting = 1 : (acting) ?]

[? if acting = 0 : Govt: [+ government_type +] ?][? if acting = 1 : No government formed ?]

[? if exiled = 0 : [? if psoe_in_government = 1 : PSOE in government ?][? if psoe_in_government = 0 : PSOE in opposition ?] ?][? if exiled = 1 : Sánchez's party: **[+ my_party +]**[? if player_leads = 1 : (leader) ?], [+ player_seats +] seats, [+ player_poll +]% ?]

[? if backbench = 1 : Sánchez sits on the PSOE backbenches. ?][? if sanchez_leader = 0 : PSOE leader: [+ psoe_leader +] ?]

PP leader: [+ pp_leader +]

[? if sanchez_leader = 1 : Authority: **[+ authority_word +]** ?]

Morale: **[+ morale_word +]**

Unity: **[+ unity_word +]**

Party funds: **[+ funds_display +]** ([+ funds_income_text +]/mo)[? if in_debt = 1 : , in debt ?]

[? if investiture_clock > 0 : Dissolution in [+ investiture_clock +] wk. ?]

[? if election_year > 0 : Election: [+ election_month : month +] [+ election_year +] ?]

= Economy & society

Economy: **[+ economy_word +]** (growth [+ growth_text +]%, unemployment [+ unemployment_text +]%)

Deficit: **[+ deficit_text +]%** of GDP, debt [+ debt +]%

Society: **[+ cohesion_word +]**

Stability: **[+ chaos_word +]**

