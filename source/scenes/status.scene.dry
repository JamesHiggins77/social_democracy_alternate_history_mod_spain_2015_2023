title: Status
new-page: true
is-special: true
on-display: {!
if (typeof window !== 'undefined' && window.SpainGame && Q.congress) {
    window.SpainGame.renderCongress(Q, 'sp-side-congress', true);
}
!}

= Status

[? if weekly = 1 : Week [+ week +], ?][+ month : month +] [+ year +]

PM: [+ pm +][? if acting = 1 : (acting) ?]

[? if psoe_in_government = 1 : PSOE in government ?][? if psoe_in_government = 0 : PSOE in opposition ?]

Authority: **[+ authority_word +]**

Morale: **[+ morale_word +]**

Unity: **[+ unity_word +]**

Party funds: **[+ funds_display +]** (+[+ funds_income +]/mo)[? if in_debt = 1 : , in debt ?]

[? if psoe_in_government = 1 : Deficit: **[+ deficit_text +]%** of GDP, debt [+ debt +]% ?]

[? if investiture_clock > 0 : Dissolution in [+ investiture_clock +] wk. ?]

[? if election_year > 0 : Election: [+ election_month : month +] [+ election_year +] ?]

