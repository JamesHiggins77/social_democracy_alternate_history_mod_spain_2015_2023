title: Post Event
new-page: true
on-arrival: {!
Q.last_advisor_action = 0;
if (typeof window !== 'undefined' && window.SpainGame) {
    if (Q.month_actions >= 1) {
        if (Q.weekly) {
            window.SpainGame.endOfWeek(Q);
        } else {
            window.SpainGame.endOfMonth(Q);
        }
    } else {
        window.SpainGame.recalculate(Q);
    }
    Q.loss_text = window.SpainGame.lossReason(Q);
}
Q.is_lost = Q.loss_text ? 1 : 0;
Q.reached_end = (Q.year > 2026) ? 1 : 0;
Q.acting = Q.government_status == 'acting' ? 1 : 0;
Q.has_event = 0;
var scene = this.game.scenes['post_event.events_choice'];
var choices = this._compileChoices(scene);
if (choices && choices.length && choices[0].title != "Continue...") {
    Q.has_event = 1;
}
!}
go-to: game_over if is_lost = 1; game_over.survived if reached_end = 1; events_choice if has_event = 1; main if has_event = 0

= [? if weekly = 1 : Week [+ week +], ?][+ month : month +] [+ year +]

@events_choice

- #sp_event

# Central monthly routine: see SpainGame.endOfMonth in out/html/spain/game_state.js.
