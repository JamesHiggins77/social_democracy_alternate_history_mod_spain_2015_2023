title: Next month
set-bg: img/spain/bg_congreso_hemiciclo.jpg
is-hand: true
on-arrival: {!
if (Q.advisor_action_timer <= 0) {
    Q.pinnedCardsDescription = 'Advisers - an action is available.';
} else if (Q.advisor_action_timer == 1) {
    Q.pinnedCardsDescription = 'Advisers - next action in 1 month.';
} else {
    Q.pinnedCardsDescription = 'Advisers - next action in ' + Q.advisor_action_timer + ' months.';
}
!}
max-cards: 3

#Decks are shown here. Clicking a deck draws a card into your hand; clicking a card plays it. Playing a card uses up the turn: a month, or a week during government formation.

[? if weekly = 1 : Government formation: each turn is one week. ?][? if election_year > 0 : A general election is called for [+ election_month : month +] [+ election_year +]. ?][? if acting = 1 : Spain has an acting government. ?][? if investiture_clock > 0 : The investiture clock is running: [+ investiture_clock +] week(s) until the Cortes are dissolved. ?][? if catalan_crisis = 1 : The Catalan crisis dominates everything. ?]

- @deck_national
- @deck_party
- @deck_negotiations
- @deck_government
- @deck_catalonia
- @deck_exile
- #sp_advisor

@deck_national
title: National politics
card-image: img/spain/deck_congreso_fachada.jpg
is-deck: true

- #sp_national

@deck_party
title: Party politics
view-if: sanchez_leader = 1
card-image: img/spain/deck_ferraz.jpg
is-deck: true

- #sp_party

@deck_negotiations
title: Government negotiations
view-if: seeking_government = 1
card-image: img/spain/event_rajoy_sanchez.jpg
is-deck: true

- #sp_negotiations

@deck_government
title: Government
view-if: player_in_government = 1 and (sanchez_leader = 1 or exiled = 1)
card-image: img/spain/bg_congreso_hemiciclo.jpg
is-deck: true

- #sp_government

@deck_catalonia
title: Catalan crisis
view-if: catalan_crisis = 1
is-deck: true

- #sp_catalonia

@deck_exile
title: Sánchez's road back
view-if: sanchez_leader = 0 and (exiled = 1 or backbench = 1 or leadership_exception_open = 1)
card-image: img/spain/portrait_sanchez_2015.jpg
is-deck: true

- #sp_exile
