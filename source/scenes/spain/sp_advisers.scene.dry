choose-if: adv_can_hernando = 1
unavailable-subtitle: Only before the 2016 leadership crisis; you can keep three advisers at a time.
on-arrival: {! if (window.SpainGame) { window.SpainGame.hireAdviser(Q, 'hernando'); } !}
go-to: team

